APP_NAME=企业知识库管理平台
APP_ENV=development
LOG_LEVEL=INFO

# 身份、业务数据和真实 LLM（密钥只写本机 .env，至少 32 位 JWT_SECRET）
DATABASE_URL=sqlite:///.local/platform.db
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
JWT_ISSUER=knowledge-platform
JWT_AUDIENCE=knowledge-platform-api
ACCESS_TOKEN_MINUTES=30
LLM_BASE_URL=https://api.siliconflow.cn/v1
LLM_MODEL=deepseek-ai/DeepSeek-V4-Pro
LLM_API_KEY=
LLM_TIMEOUT=90
LLM_MAX_TOKENS=1500
CHAT_HISTORY_MESSAGES=12
CHAT_CONTEXT_CHARS=18000
RESTRICTED_SCORE_THRESHOLD=0.35

# 文档与切分
MAX_UPLOAD_BYTES=20971520
MAX_CHUNK_SIZE=1000
CHUNK_OVERLAP=100
MAX_BATCH_FILES=20

# 远程 BGE-M3 服务；请填写真实地址，不要提交 .env
BGE_BASE_URL=http://your-bge-host:8000
BGE_EMBEDDING_PATH=/v1/embedding
BGE_HEALTH_PATH=/health
BGE_API_KEY=
EMBEDDING_BATCH_SIZE=16
DENSE_VECTOR_SIZE=1024
EMBEDDING_MODEL_ID=bge-m3

# 远程 Reranker 服务
RERANKER_BASE_URL=http://your-reranker-host:8000
RERANKER_PATH=/v1/rerank
RERANKER_HEALTH_PATH=/health
RERANKER_API_KEY=

# 外部 HTTP 调用
HTTP_CONNECT_TIMEOUT=5
HTTP_READ_TIMEOUT=60
HTTP_MAX_RETRIES=2

# Qdrant
QDRANT_URL=http://your-qdrant-host:6333
# 无 Docker 的本地开发可清空 QDRANT_URL，并把下项设为例如 ./.local/qdrant
QDRANT_LOCATION=
QDRANT_API_KEY=
QDRANT_COLLECTION=knowledge_chunks_v1
QDRANT_PREFER_GRPC=false
QDRANT_UPSERT_BATCH_SIZE=64

# 检索
RRF_K=60
SEARCH_CANDIDATE_LIMIT=30
RERANK_TOP_K=5

# FAQ 与知识缺口阈值
FAQ_SIMILARITY_THRESHOLD=0.88
FAQ_MIN_OCCURRENCES=2
GAP_RETRIEVAL_SCORE_THRESHOLD=0.015
GAP_RERANK_SCORE_THRESHOLD=0.0

# 仅供可选的外部集成测试使用
TEST_TENANT_ID=tenant-demo
TEST_KB_ID=kb-demo
TEST_QUERY=企业知识库支持什么功能？
RUN_EXTERNAL_INTEGRATION=0
